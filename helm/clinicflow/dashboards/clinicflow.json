    {
      "id": 19,
      "type": "timeseries",
      "title": "Front-desk actions per minute",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(clinic_status_changes_total{namespace=\"$namespace\"}[5m])) * 60",
          "legendFormat": "{{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rate(clinic_booking_conflicts_total{namespace=\"$namespace\"}[5m])) * 60",
          "legendFormat": "double-booking rejected",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
